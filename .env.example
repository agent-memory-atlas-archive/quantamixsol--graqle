# graqle — environment template (copy to .env; never commit .env)
#
# Every variable below is a NAME. Values marked <set-in-private-config> are
# TS-2/TS-3 tuning values that live in the gitignored private config file
# (GRAQLE_DAG_SECRETS_PATH) or in the deployment environment — never here and
# never in the public repository. Values marked <safe-default> have a non-zero
# operational default compiled into the SDK; leave them unset unless you must
# override. The environment always wins over the private config file.

# ── DAG-2026 Decision Assurance Gate (CR-012 foundation) ───────────────────────
# Single source of truth. `assurance.enabled` in graqle.yaml is DERIVED from this
# and must NOT be set in yaml (ConfigurationError if present).
GRAQLE_DAG_ENABLED=false

# Private config file holding TS-2/TS-3 numeric values (gitignored). Optional; env wins.
GRAQLE_DAG_SECRETS_PATH=.graqle/graqle_secrets.yaml

# Deployment secret keying the config_version fingerprint (PR-339 B1 / ruling N2).
# REQUIRED when enabled; at least 32 bytes; never logged, never serialised.
# Generate it with a CSPRNG — `openssl rand -base64 48` — never a passphrase or
# any human-chosen string. Rotating it changes every config_version computed
# afterwards; see docs/dag/ground-truth-addendum.md ("Operating the DAG flag").
GRAQLE_DAG_CONFIG_SALT=<set-in-private-config>

# Trace schema (CR-012 §4.4). Pin readers; STRICT=true rejects unknown versions instead of WARNING.
GRAQLE_TRACE_SCHEMA_VERSION=3
GRAQLE_TRACE_SCHEMA_STRICT=false

# CR-013 hard gates + cap — REQUIRED when enabled; 0 is rejected.
GRAQLE_DAG_CAP_VALUE=<set-in-private-config>
GRAQLE_DAG_HG05_POISONING_THRESHOLD=<set-in-private-config>
GRAQLE_DAG_HG07_MATERIALITY_THRESHOLD=<set-in-private-config>
GRAQLE_DAG_HG03_IMPACT_TIER_MIN=HIGH
GRAQLE_DAG_RBAC_TIMEOUT_MS=<safe-default>
GRAQLE_DAG_GATE_TIMEOUT_MS=<safe-default>

# CR-014 confidence vector — REQUIRED when enabled
GRAQLE_DAG_CALIBRATOR_VERSION=<set-in-private-config>
GRAQLE_DAG_CALIBRATOR_TTL_HOURS=<safe-default>     # DEPRECATED alias of GRAQLE_DAG_CV_CALIBRATOR_TTL_SECONDS (seconds); remove next minor
GRAQLE_DAG_CV_CALIBRATOR_TTL_SECONDS=<set-in-private-config>
GRAQLE_DAG_CV_MAX_DIVERGENCE=<set-in-private-config>
GRAQLE_DAG_CV_CALIBRATOR_REGISTRY_PATH=<registry-directory>
GRAQLE_DAG_CV_PROJECTION_STRATEGY=rule_only         # linear | monotonic | calibrated_tree | rule_only
GRAQLE_DAG_CV_POLICY_THRESHOLD_ENTITY=<set-in-private-config>
GRAQLE_DAG_CV_POLICY_THRESHOLD_RELATION=<set-in-private-config>
GRAQLE_DAG_CV_POLICY_THRESHOLD_ABSTRACTION=<set-in-private-config>
GRAQLE_DAG_CV_POLICY_THRESHOLD_DECISION=<set-in-private-config>
GRAQLE_DAG_CV_MANDATORY_DIMS_ENTITY=<csv-of-dimension-names>
GRAQLE_DAG_CV_MANDATORY_DIMS_RELATION=<csv-of-dimension-names>
GRAQLE_DAG_CV_MANDATORY_DIMS_ABSTRACTION=<csv-of-dimension-names>
GRAQLE_DAG_CV_MANDATORY_DIMS_DECISION=<csv-of-dimension-names>
GRAQLE_DAG_CV_HALF_LIFE_SECONDS_CODE=<set-in-private-config>
GRAQLE_DAG_CV_HALF_LIFE_SECONDS_API_SPEC=<set-in-private-config>
GRAQLE_DAG_CV_HALF_LIFE_SECONDS_JSON_CONFIG=<set-in-private-config>
GRAQLE_DAG_CV_HALF_LIFE_SECONDS_USER_TAUGHT=<set-in-private-config>
GRAQLE_DAG_CV_HALF_LIFE_SECONDS_DOCUMENT=<set-in-private-config>
GRAQLE_DAG_CV_HALF_LIFE_SECONDS_TOOL_RESULT=<set-in-private-config>
GRAQLE_DAG_CV_HALF_LIFE_SECONDS_WEB=<set-in-private-config>
GRAQLE_DAG_CV_WEIGHT_SOURCE_RELIABILITY=<safe-default>   # all seven weights or none; must sum to 1
GRAQLE_DAG_CV_WEIGHT_EXTRACTION_RELIABILITY=<safe-default>
GRAQLE_DAG_CV_WEIGHT_CORROBORATION=<safe-default>
GRAQLE_DAG_CV_WEIGHT_TEMPORAL_VALIDITY=<safe-default>
GRAQLE_DAG_CV_WEIGHT_CONTEXT_FIT=<safe-default>
GRAQLE_DAG_CV_WEIGHT_REASONING_SUPPORT=<safe-default>
GRAQLE_DAG_CV_WEIGHT_OPERATIONAL_RELIABILITY=<safe-default>
GRAQLE_DAG_CV_PENALTY_CONTRADICTION=<safe-default>       # all three penalties or none
GRAQLE_DAG_CV_PENALTY_STALENESS=<safe-default>
GRAQLE_DAG_CV_PENALTY_DEPENDENCY=<safe-default>
GRAQLE_DAG_CV_SOURCE_SATURATION=<safe-default>
GRAQLE_DAG_CV_SAME_BUNDLE_SECONDS=<safe-default>
GRAQLE_DAG_CV_TC_ECE_POSITION_EDGES=<safe-default>
GRAQLE_DAG_CV_BOOTSTRAP_RESAMPLES=<safe-default>
GRAQLE_DAG_CV_BOOTSTRAP_ALPHA=<safe-default>
GRAQLE_DAG_CV_BOOTSTRAP_SEED=<safe-default>
GRAQLE_DAG_CV_RULE_FLOOR_SOURCE_RELIABILITY=<set-in-private-config>   # rule_only: one floor per mandatory dimension
GRAQLE_DAG_CV_RULE_FLOOR_EXTRACTION_RELIABILITY=<set-in-private-config>
GRAQLE_DAG_CV_RULE_FLOOR_CORROBORATION=<set-in-private-config>
GRAQLE_DAG_CV_RULE_FLOOR_TEMPORAL_VALIDITY=<set-in-private-config>
GRAQLE_DAG_CV_RULE_FLOOR_CONTEXT_FIT=<set-in-private-config>
GRAQLE_DAG_CV_RULE_FLOOR_REASONING_SUPPORT=<set-in-private-config>
GRAQLE_DAG_CV_RULE_FLOOR_OPERATIONAL_RELIABILITY=<set-in-private-config>
GRAQLE_DAG_CV_KNOTS_PATH=<private-json-path>             # monotonic strategy knots
GRAQLE_DAG_CV_TREE_PATH=<private-json-path>              # calibrated_tree strategy tree
GRAQLE_DAG_CV_TREE_MAX_DEPTH=<set-in-private-config>
GRAQLE_DAG_CV_WEIGHTS_REF=cv_weights_v1          # key name inside the private config file, never the values
GRAQLE_DAG_CV_MAX_RAW_CAL_DIVERGENCE=<set-in-private-config>
GRAQLE_DAG_TEMPORAL_HALFLIFE_DAYS=<set-in-private-config>

# CR-015 trajectory / replan / escalation — REQUIRED when enabled
GRAQLE_DAG_TRAJECTORY_ESTIMATOR=<registry-name>
GRAQLE_DAG_MAX_RETRY_BUDGET=<set-in-private-config>
GRAQLE_DAG_CIRCUIT_BREAKER_WINDOW=<set-in-private-config>
GRAQLE_DAG_ESCALATION_ROLE=lead
GRAQLE_DAG_ESCALATION_SLA_MINUTES=<safe-default>

# CR-016 / CR-017 ontology + propagation
GRAQLE_DAG_ONTOLOGY_SHAPES_PATH=
GRAQLE_DAG_PROV_EXPORT_ENABLED=false
GRAQLE_DAG_PROPAGATION_MAX_DEPTH=<safe-default>
GRAQLE_DAG_RECOMPUTE_QUEUE_PATH=.graqle/dag/recompute_queue.jsonl
GRAQLE_DAG_SCOPE_KEY_FIELDS_REF=<ref-name>          # REQUIRED when enabled; the value lives under refs: in the private config
GRAQLE_DAG_MERGE_PRIORITY_REF=<ref-name>            # REQUIRED when enabled; a ref name, or sdk_default
GRAQLE_DAG_ASSURANCE_SECONDARY_LABELS=true
GRAQLE_DAG_ASSURANCE_LABEL_CEILING=<set-in-private-config>
GRAQLE_DAG_ASSURANCE_MIGRATION_BATCH=<set-in-private-config>
GRAQLE_DAG_ASSURANCE_HMAC_VERSION=v1
GRAQLE_DAG_CONFIG_SALT_PREVIOUS=                    # key-rotation overlap window only
GRAQLE_DAG_ASSURANCE_HMAC_VERSION_PREVIOUS=

# CR-018 provenance event + action binding — REQUIRED when enabled
GRAQLE_DAG_SIGNING_KEY_ID=<kid>
GRAQLE_DAG_SIGNING_KEY_VERSION=<version>
GRAQLE_DAG_SIGNING_KEY_MAX_AGE_DAYS=<safe-default>
GRAQLE_DAG_ARGS_HASH_ALGO=sha256
GRAQLE_DAG_PROVENANCE_MERKLE_BATCH=false

# CR-019 benchmark harness
GRAQLE_DAG_BENCH_RESULTS_DIR=.graqle/dag/bench
GRAQLE_DAG_BENCH_SEED=<safe-default>
# ── /DAG-2026 ──────────────────────────────────────────────────────────────────
